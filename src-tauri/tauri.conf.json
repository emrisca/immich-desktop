{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Immich Desktop",
  "version": "0.1.2",
  "identifier": "dev.emrys.immich",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Immich Desktop",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#1e1e1e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRDE5NjYzQjlFMEM5NzkKUldSNXllQzVZNWJSRVBkNUdIU3RGYlRvQ2pRRUt0eGlxc3lBNnFtVzUwaTZNTWRvalJ0NjNvekwK",
      "endpoints": [
        "https://github.com/emrisca/immich-desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../runtime/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
